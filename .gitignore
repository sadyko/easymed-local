# Easy-Med Local — fully local project, no server/deploy artifacts.

# --- Secrets guard (none should ever exist in this project) ---
*.env
*.env.*
*.pem
*.key
*.pfx

# --- Dependencies / build output (regenerable) ---
node_modules/
dist/
build/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Ad-hoc edit backups ---
*.bak
*.bak.*
*bak-*

# --- Local runtime state ---
data/
backups/

# --- Signed release bundles (AUTO_ROLLOUT_V1) ---
# Where the control plane stores the .tar.gz CI uploads, when
# EASYMED_CP_RELEASES_DIR is left at its default. On the vendor server that
# directory is elsewhere (nginx serves it at /releases/); here it only appears
# after a local experiment, and a ~15 MB bundle must never be committed.
control-plane/releases/

# --- Vendor licence signing material — must NEVER reach a clinic or a repo ---
vendor-private.pem
control-*.json
licence-*.dat
